<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:background="@color/colorPrimaryDark">

    <!-- 结果文本区域 -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:id="@+id/result_text_card"
        app:cardBackgroundColor="@android:color/white"
        app:cardCornerRadius="8dp"
        app:cardElevation="4dp"
        app:layout_constraintBottom_toTopOf="@id/start_button"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="16dp">

            <TextView
                android:id="@+id/result_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="识别结果将显示在这里..."
                android:textAppearance="@style/TextAppearance.App.Body1" />
        </androidx.core.widget.NestedScrollView>
    </com.google.android.material.card.MaterialCardView>

    <!-- 开始录音按钮 -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/start_button"
        style="@style/Widget.MaterialComponents.Button"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="开始录音"
        android:textAppearance="@style/TextAppearance.App.Button"
        android:enabled="false"
        app:backgroundTint="@color/colorPrimary"
        app:cornerRadius="8dp"
        app:icon="@drawable/mic_24px"
        app:iconTint="@android:color/white"
        app:layout_constraintBottom_toTopOf="@id/exit_button"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/result_text_card" />

    <!-- 退出按钮 -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/exit_button"
        style="@style/Widget.MaterialComponents.Button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:text="退出"
        android:textAppearance="@style/TextAppearance.App.Button"
        app:backgroundTint="@color/colorPrimaryDark"
        app:cornerRadius="8dp"
        app:icon="@drawable/exit_to_app_24px"
        app:iconTint="@android:color/white"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
    <!-- 热词/设置按钮 -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/voc_button"
        style="@style/Widget.MaterialComponents.Button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:text="热词"
        android:textAppearance="@style/TextAppearance.App.Button"
        app:backgroundTint="@color/colorPrimaryDark"
        app:cornerRadius="8dp"
        app:icon="@drawable/calendar_star"
        app:iconTint="@android:color/white"
        android:visibility="gone"
        tools:visibility="visible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />
    <com.google.android.material.button.MaterialButton
        android:id="@+id/voc_check_button"
        style="@style/Widget.MaterialComponents.Button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:text="查看"
        android:textAppearance="@style/TextAppearance.App.Button"
        app:backgroundTint="@color/colorPrimaryDark"
        app:cornerRadius="8dp"
        app:iconTint="@android:color/white"
        android:visibility="gone"
        tools:visibility="visible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/voc_button" />
    <com.google.android.material.button.MaterialButton
        android:id="@+id/lang_button"
        style="@style/Widget.MaterialComponents.Button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:text="语言"
        android:textAppearance="@style/TextAppearance.App.Button"
        app:backgroundTint="@color/colorPrimaryDark"
        app:cornerRadius="8dp"
        app:iconTint="@android:color/white"
        android:visibility="gone"
        tools:visibility="visible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/voc_check_button" />
</androidx.constraintlayout.widget.ConstraintLayout>
